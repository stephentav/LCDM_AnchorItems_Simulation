<Project>
  Title = "Flexmirt Template - Vertical Linking Study"; 
  Description = "Template for single group calibration of Simulation Data Sets for True Q-Matrix"; 

<Options>
  Mode = Calibration; 
  MaxE = 20000; 
  MaxM = 5; 
  Etol = 1e-6; 
  Mtol = 1e-9;  
  Processors = 10;
GOF = Extended;  
  SavePrm = Yes;
  SaveCOV = Yes; 
  SavePRM = Yes;
  SaveSCO = Yes;
  Score = EAP;
  DMtable = Yes;

<Groups>
  // define your groups and group names - data is compiled into one group
  %G3%
  File = "responses_G3.csv"; // File path for each of the data sets - '/Users/stephentavares/Library/CloudStorage/GoogleDrive-st4yk@virginia.edu/My Drive/VS_CDM/simlcdm_out/C009/rep_010/responses_G3.csv' - Change the condition, repitition, and grade .csv
  
  Varnames = Grade, I1 - I30, J1 - J30, K1 - K30; // in data frame, must combine data sets and then change the item codes 
                                                  // items that start with I are 3rd grade, J are 4th grade, and k are 5th grade
  
  Select = I1 - I30, J1 - J30, K1 - K30;
  
  Missing = -99;
  N = 500; // pull from rep_manifest.csv this needs to be adjusted for each repitition
  Ncats(_ALL_) = 2; 
  Model(_ALL_) = Graded(2); 
  Attributes = 4;
  InteractionEffects = 2;
  Dimensions = 10;
  
<Constraints> 
  
  // Main effects for G3
  Fix G3,(I1 - I30,
          J1 - J30,
          K1 - K30),
  MainEffect; 
  
  Free G3,(I1), MainEffect(1);
  Free G3,(I2), MainEffect(2);
