<Project>
  Title = "Flexmirt Template - Vertical Linking Study"; 
  Description = "Template for concurrent calibration of Simulation Data Sets for True Q-Matrix"; 

<Options>
  Mode = Calibration; 
  MaxE = 20000; 
  MaxM = 5; 
  Etol = 1e-6; 
  Mtol = 1e-9;  
  Processors = 10;
GOF = Extended;  
  SavePrm = Yes;
  SaveCOV = Yes; 
  SavePRM = Yes;
  SaveSCO = Yes;
  Score = EAP;
  DMtable = Yes;

<Groups>
  // define your groups and group names
  %G3%
  File = "\\Mac\Home\Library\CloudStorage\GoogleDrive-st4yk@virginia.edu\My Drive\VS_CDM\simlcdm_out\C001\rep_001\responses_G3.csv"; // File path for each of the data sets - '/Users/stephentavares/Library/CloudStorage/GoogleDrive-st4yk@virginia.edu/My Drive/VS_CDM/simlcdm_out/C009/rep_010/responses_G3.csv' - Change the condition, repitition, and grade .csv
  
  Varnames = I1, I2, I3, I4, I5, I6, I7, I8, I9, I10, 
       I11, I12, I13, I14, I15, I16, I17, I18, I19, I20, 
       I21, I22, I23, I24, I25, I26, I27, I28, I29, I30; 
  
  Select = I1, I2, I3, I4, I5, I6, I7, I8, I9, I10, 
       I11, I12, I13, I14, I15, I16, I17, I18, I19, I20, 
       I21, I22, I23, I24, I25, I26, I27, I28, I29, I30;
  
  Missing = -99;
  N = 500; // pull from rep_manifest.csv this needs to be adjusted for each repitition
  Ncats(_ALL_) = 2; 
  Model(_ALL_) = Graded(2); 
  Attributes = 4;
  InteractionEffects = 2;
  Dimensions = 10;
  
  %G4%
  File = "\\Mac\Home\Library\CloudStorage\GoogleDrive-st4yk@virginia.edu\My Drive\VS_CDM\simlcdm_out\C001\rep_001\responses_G4.csv"; // File path for each of the data sets - '/Users/stephentavares/Library/CloudStorage/GoogleDrive-st4yk@virginia.edu/My Drive/VS_CDM/simlcdm_out/C009/rep_010/responses_G4.csv' - Change the condition, repitition, and grade .csv

  Varnames = I1, I2, I3, I4, I5, I6, I7, I8, I9, I10, 
       I11, I12, I13, I14, I15, I16, I17, I18, I19, I20, 
       I21, I22, I23, I24, I25, I26, I27, I28, I29, I30; 
  
  Select = I1, I2, I3, I4, I5, I6, I7, I8, I9, I10, 
       I11, I12, I13, I14, I15, I16, I17, I18, I19, I20, 
       I21, I22, I23, I24, I25, I26, I27, I28, I29, I30;
  
  Missing = -99;
  N = 500; // pull from rep_manifest.csv this needs to be adjusted for each repitition
  Ncats(_ALL_) = 2; 
  Model(_ALL_) = Graded(2); 
  Attributes = 4;
  InteractionEffects = 2;
  Dimensions = 10; // 4 main + 6 2nd-order
  
  %G5%
  File = "\\Mac\Home\Library\CloudStorage\GoogleDrive-st4yk@virginia.edu\My Drive\VS_CDM\simlcdm_out\C001\rep_001\responses_G5.csv"; // File path for each of the data sets - '/Users/stephentavares/Library/CloudStorage/GoogleDrive-st4yk@virginia.edu/My Drive/VS_CDM/simlcdm_out/C009/rep_010/responses_G5.csv' - Change the condition, repitition, and grade .csv

  Varnames = I1, I2, I3, I4, I5, I6, I7, I8, I9, I10, 
       I11, I12, I13, I14, I15, I16, I17, I18, I19, I20, 
       I21, I22, I23, I24, I25, I26, I27, I28, I29, I30; 
  
  Select = I1, I2, I3, I4, I5, I6, I7, I8, I9, I10, 
